--  Configuration for enet generated by Alire
pragma Restrictions (No_Elaboration_Code);
pragma Style_Checks (Off);

package Enet_Config is
   pragma Pure;

   Crate_Version : constant String := "1.1.0";
   Crate_Name : constant String := "enet";

   Alire_Host_OS : constant String := "linux";

   Alire_Host_Arch : constant String := "x86_64";

   Alire_Host_Distro : constant String := "ubuntu";

   Headroom_First : constant :=  0;
   Headroom_Last : constant :=  255;
   Headroom : constant :=  0;

   type Default_Random_Kind is (discrete, none);
   Default_Random : constant Default_Random_Kind := discrete;

   type Build_Profile_Kind is (release, validation, development);
   Build_Profile : constant Build_Profile_Kind := development;

   Tailroom_First : constant :=  0;
   Tailroom_Last : constant :=  255;
   Tailroom : constant :=  0;

end Enet_Config;
